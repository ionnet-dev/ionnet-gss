##########
# Server #
##########
# Port the panel listens on (API, WebSockets and the web app).
PORT=3200
# Interface to listen on. Empty = 127.0.0.1 in development, 0.0.0.0 in production (Docker, behind a reverse proxy).
# Set 0.0.0.0 in development only when agents on other machines must reach this panel.
HOST=
# Public address of the panel. Used in enrol commands, invite links and the WebSocket origin check.
PUBLIC_URL=http://localhost:3200
# development | production. Production serves client/dist instead of proxying Vite and listens on 0.0.0.0.
# `deno task start` always runs in production; `deno task dev` uses this value.
DENO_ENV=development
# Vite dev server the panel proxies to in development.
VITE_URL=http://localhost:5200
# Built web app, served with an index.html fallback in production. Relative to the repo root.
CLIENT_DIST=client/dist
# Trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy. Only set when the panel is behind one.
TRUST_PROXY=false
# Panel data folder (definition source clones, the generated jwt-secret). Under Docker it is a mounted volume.
DATA_DIR=./data

############
# Database #
############
DB_HOST=127.0.0.1
# 3308 is docker-compose.dev.yml's MariaDB.
DB_PORT=3308
DB_NAME=gss
DB_USER=gss
DB_PASSWORD=gss
# Root password for the production compose file's MariaDB.
DB_ROOT_PASSWORD=
# Run pending migrations at startup.
AUTO_MIGRATE=true
# Log every SQL statement (noisy).
LOG_SQL=false

########
# Auth #
########
# Signs the JWT bearer tokens: 32+ random characters (`openssl rand -hex 32`). Leave empty to have the panel generate
# one on first start and keep it in DATA_DIR/jwt-secret (mode 0600); that is the default in development and Docker,
# as long as DATA_DIR is persistent (a new secret signs everyone out). Set it explicitly to run several panels.
JWT_SECRET=
# Lifetime of a login token, in hours.
JWT_TTL_HOURS=168
# Lifetime of an invite link, in hours.
INVITE_TTL_HOURS=72

##########
# Limits #
##########
# Largest request body accepted under /api, in KB (413 above).
BODY_LIMIT_KB=1024
# Window of the in-memory rate limits below, in seconds. Over a limit the panel answers 429 until the window ends.
# 0 turns a limit off. Client IPs come from X-Forwarded-For only with TRUST_PROXY=true.
RATE_LIMIT_WINDOW_SEC=900
# Sign-in attempts per client IP and window.
RATE_LIMIT_LOGIN_PER_IP=30
# Failed sign-ins per username and window (a success resets it).
RATE_LIMIT_LOGIN_FAILURES_PER_USER=10
# Requests per client IP and window to setup, register and the invite preview.
RATE_LIMIT_PUBLIC_PER_IP=60
# Largest file upload in the file manager, in MB. Uploads are streamed to the host, so BODY_LIMIT_KB doesn't apply.
UPLOAD_MAX_MB=4096
# Uploads and downloads (files and backups) one user may run at the same time (429 beyond).
TRANSFERS_PER_USER=4

##########
# Agents #
##########
# Lifetime of a host enrolment token, in minutes.
ENROL_TOKEN_TTL_MINUTES=60
# Seconds between agent heartbeats (sent to the agent in the hello response).
AGENT_HEARTBEAT_SEC=15
# Seconds without a heartbeat before a connected host counts as offline.
AGENT_OFFLINE_AFTER_SEC=45
# Seconds the panel waits for an agent to answer a request.
AGENT_REQUEST_TIMEOUT_SEC=30
# M5: folder with the agent builds the panel serves to the install script (`make dist` in agent/ writes it)
AGENT_DIST_DIR=agent/dist

#########
# Hosts #
#########
# Port pool for newly enrolled hosts: comma-separated ranges, editable per host.
DEFAULT_PORT_POOL=25565-25664,27015-27064

#########
# Games #
#########
# The built-in definition source (the repo's games/ folder, a git submodule), relative to the repo root. Synced at
# startup. The Docker image has no such folder and uses OFFICIAL_SOURCE_URL instead.
GAMES_DIR=games
# Git source a panel without GAMES_DIR adds at its first start. Empty = none (add sources yourself).
OFFICIAL_SOURCE_URL=https://github.com/ionnet-dev/ionnet-gss-games.git
# Registry prefix for bare `ionnet-gss-*` image names in game.yml (untagged ones get :latest). Agents pull an image
# only when it is missing locally, so `deno task images:build` output is used as is.
IMAGE_REGISTRY=ghcr.io/ionnet-dev

###########
# Sources #
###########
# Minutes between automatic syncs of git definition sources (a source can override it; 0 = manual only).
SOURCE_SYNC_INTERVAL_MIN=60
# Seconds one git clone/fetch may take.
SOURCE_GIT_TIMEOUT_SEC=60
# Largest checkout accepted, in MB, and the most files in it.
SOURCE_MAX_MB=50
SOURCE_MAX_FILES=5000
# Comma-separated https hosts that `options_from` lists in game.yml may be fetched from.
OPTIONS_FETCH_HOSTS=piston-meta.mojang.com,launchermeta.mojang.com,api.papermc.io,maven.minecraftforge.net,meta.prismlauncher.org
# Minutes a fetched option list is cached.
OPTIONS_CACHE_MIN=15

##########
# Quotas #
##########
# Used where a user's own quota field is empty (null = use these). Admins have no quota.
DEFAULT_QUOTA_SERVERS=2
DEFAULT_QUOTA_MEMORY_MB=4096
DEFAULT_QUOTA_CPU_MILLIS=2000
DEFAULT_QUOTA_DISK_MB=20480
DEFAULT_QUOTA_BACKUPS=5
